# ==============================================================================
# OmniThread OS - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env: cp .env.example .env
#   2. Edit .env and set all values (especially in PRODUCTION)
#   3. NEVER commit .env to version control
#   4. For production: Set strong random values for all SECRET_* variables
#
# SECURITY NOTE:
#   - All SECRET_* and PASSWORD variables MUST be set explicitly
#   - There are NO default secrets for production deployments
#   - Application will FAIL to start in production if secrets are missing
# ==============================================================================

# Application Settings
# ENVIRONMENT can be: development, staging, production
ENVIRONMENT=development
PORT=8080
DEBUG=False

# Security & Encryption (REQUIRED - No defaults in production)
# Generate strong keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# For local development, use: dev-secret-key-change-in-production-or-staging
SECRET_KEY=
ENCRYPTION_ALGORITHM=HS256

# API Security (REQUIRED - No defaults in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
API_TIMEOUT=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
# SQLite (development): sqlite:///./omnithread_enterprise.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/omnithread_db
DATABASE_URL=sqlite:///./omnithread_enterprise.db
DB_FILE=omnithread_enterprise.db
DB_ECHO=False
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/omnithread.log
LOG_FORMAT=json

# Monitoring & Telemetry
TELEMETRY_ENABLED=True
TELEMETRY_INTERVAL_SECONDS=60

# Multi-Node Configuration
NODE_NAME=local-node-01
NODE_ID=node-001
CLUSTER_ENABLED=True

# Multi-Tenancy
MULTI_TENANT_ENABLED=True
DEFAULT_TENANT=default

# Third-Party Integrations (Optional)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Kubernetes Integration
K8S_ENABLED=False
K8S_NAMESPACE=default
K8S_CONFIG_PATH=~/.kube/config

# Redis (Optional - for caching/sessions)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# Feature Flags
ENABLE_PROMETHEUS_EXPORT=True
ENABLE_AUTO_REMEDIATION=True
ENABLE_AI_PREDICTIONS=True
